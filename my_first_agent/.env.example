# Copy this file to .env and fill in your own keys.

# 0 = use the Gemini API with an API key from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-gemini-api-key

# From https://www.firecrawl.dev (free plan available)
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# Lets the YAML config start the Firecrawl MCP server as a local process.
# Only set this for agent configs you wrote or trust.
ADK_ALLOW_CONFIG_STDIO_MCP_SERVERS=1
